# =========================================================
# NovaLingua Infrastructure
# Repository-wide exclusions
# =========================================================

# -------------------------
# Virtual machines / disks
# -------------------------
*.ova
*.ovf
*.vmdk
*.vdi
*.vhd
*.vhdx
*.qcow
*.qcow2
*.img
*.iso

# -------------------------
# GNS3 temporary/runtime data
# -------------------------
*.log
*.lock
*.pid
*.tmp

# -------------------------
# Node / web project
# -------------------------
node_modules/
dist/
.astro/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Environment variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# IDE / editor files
# -------------------------
.vscode/
.idea/

# -------------------------
# Operating system files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Temporary / backup files
# -------------------------
*.bak
*.swp
*.swo
*~

# GNS3 / Dynamips generated runtime files
gns3/project-files/dynamips/

# Large GNS3 snapshots
gns3/snapshots/